{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "python3 zhongtai/tools/build_online.py",
  "outputDirectory": "zhongtai/.publish",
  "headers": [
    {
      "source": "/pc/share/dist/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/zhongtai/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/zhongtai/zhongtai.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
